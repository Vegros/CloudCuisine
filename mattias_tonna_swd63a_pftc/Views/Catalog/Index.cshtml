@model List<mattias_tonna_swd63a_pftc.Models.CatalogItem>
@using System.Globalization

@{
ViewData["Title"] = "Menu Catalog — CloudCuisine";
bool isEmpty = Model == null || Model.Count == 0;
}

@section Styles {
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    /* ── Reset ───────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; }

    :root {
        --bg-deep:        #08030f;
        --bg-base:        #0e0719;
        --bg-card:        rgba(22, 11, 42, 0.72);
        --bg-card-hover:  rgba(34, 16, 62, 0.85);
        --border:         rgba(139, 92, 246, 0.18);
        --border-hover:   rgba(167, 139, 250, 0.42);
        --violet:         #8b5cf6;
        --violet-mid:     #a78bfa;
        --violet-light:   #c084fc;
        --text-primary:   #f3eeff;
        --text-secondary: #b8aad4;
        --text-muted:     #7264a0;
        --success:        #4ade80;
        --radius-card:    16px;
        --radius-input:   11px;
        --transition:     0.22s cubic-bezier(.4,0,.2,1);
    }

    body {
        margin: 0;
        font-family: 'Inter', sans-serif;
        background: var(--bg-deep);
        color: var(--text-primary);
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
    }

    /* ── Page shell ──────────────────────────────────────────── */
    .cc-catalog-page {
        position: relative;
        min-height: 100vh;
        padding: 3.5rem 1rem 5rem;
        overflow-x: hidden;
    }

    .cc-catalog-page::before,
    .cc-catalog-page::after {
        content: '';
        position: fixed;
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
        filter: blur(90px);
    }

    .cc-catalog-page::before {
        width: 640px; height: 640px;
        top: -180px; left: -160px;
        background: radial-gradient(circle, rgba(139,92,246,0.2) 0%, transparent 70%);
    }

    .cc-catalog-page::after {
        width: 520px; height: 520px;
        bottom: -140px; right: -140px;
        background: radial-gradient(circle, rgba(192,132,252,0.13) 0%, transparent 70%);
    }

    .cc-catalog-inner {
        position: relative;
        z-index: 1;
        max-width: 1160px;
        margin: 0 auto;
    }

    /* ── Page header ─────────────────────────────────────────── */
    .cc-page-header {
        margin-bottom: 2.5rem;
        animation: cc-fade-up 0.45s ease both;
    }

    .cc-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.32rem 0.9rem;
        background: rgba(139,92,246,0.1);
        border: 1px solid rgba(139,92,246,0.22);
        border-radius: 100px;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: var(--violet-mid);
        margin-bottom: 1rem;
    }

    .cc-eyebrow-dot {
        width: 5px; height: 5px;
        border-radius: 50%;
        background: var(--violet-light);
        box-shadow: 0 0 8px var(--violet-light);
        animation: cc-pulse 2s ease-in-out infinite;
    }

    .cc-page-header h1 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(1.9rem, 4vw, 2.9rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1.08;
        margin: 0 0 0.6rem;
        background: linear-gradient(135deg, #e9d5ff 0%, var(--violet-light) 50%, var(--violet-mid) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .cc-page-header p {
        color: var(--text-secondary);
        font-size: 0.97rem;
        margin: 0;
        max-width: 520px;
        line-height: 1.55;
    }

    /* ── Stats bar ───────────────────────────────────────────── */
    .cc-stats-bar {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.75rem;
        flex-wrap: wrap;
        animation: cc-fade-up 0.45s 0.05s ease both;
    }

    .cc-stat {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.5rem 0.9rem;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 10px;
        backdrop-filter: blur(10px);
    }

    .cc-stat-num {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1;
    }

    .cc-stat-label {
        font-size: 0.78rem;
        color: var(--text-muted);
        font-weight: 500;
    }

    /* ── Toolbar ─────────────────────────────────────────────── */
    .cc-toolbar {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 1.75rem;
        flex-wrap: wrap;
        align-items: center;
        animation: cc-fade-up 0.45s 0.1s ease both;
    }

    .cc-search-wrap {
        position: relative;
        flex: 1;
        min-width: 220px;
    }

    .cc-search-input {
        width: 100%;
        padding: 0.72rem 2.2rem 0.72rem 1rem;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-input);
        color: var(--text-primary);
        font-family: 'Inter', sans-serif;
        font-size: 0.9rem;
        outline: none;
        transition: all var(--transition);
        backdrop-filter: blur(10px);
    }

    .cc-search-input::placeholder { color: var(--text-muted); }

    .cc-search-input:focus {
        border-color: var(--violet-mid);
        box-shadow: 0 0 0 4px rgba(139,92,246,0.12);
        background: rgba(16,8,32,0.85);
    }

    .cc-search-clear {
        position: absolute;
        right: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: var(--text-muted);
        cursor: pointer;
        padding: 0.2rem;
        display: none;
        align-items: center;
        transition: color var(--transition);
        border-radius: 4px;
        font-size: 0.85rem;
    }

    .cc-search-clear:hover { color: var(--text-primary); }
    .cc-search-clear.cc-visible { display: flex; }

    /* sort */
    .cc-sort-select {
        padding: 0.72rem 1rem;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-input);
        color: var(--text-primary);
        font-family: 'Inter', sans-serif;
        font-size: 0.88rem;
        font-weight: 500;
        outline: none;
        cursor: pointer;
        transition: all var(--transition);
        backdrop-filter: blur(10px);
        appearance: none;
        -webkit-appearance: none;
        min-width: 160px;
    }

    .cc-sort-select:focus {
        border-color: var(--violet-mid);
        box-shadow: 0 0 0 4px rgba(139,92,246,0.12);
    }

    /* result count */
    .cc-result-count {
        font-size: 0.8rem;
        color: var(--text-muted);
        font-weight: 500;
        white-space: nowrap;
        padding: 0 0.25rem;
    }

    /* ── Items grid ──────────────────────────────────────────── */
    .cc-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
        gap: 1rem;
        animation: cc-fade-up 0.45s 0.15s ease both;
    }

    .cc-item-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-card);
        padding: 1.25rem 1.35rem 1.15rem;
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        transition: all var(--transition);
        position: relative;
        overflow: hidden;
        cursor: default;
        box-shadow:
            0 0 0 1px rgba(139,92,246,0.04),
            0 8px 28px rgba(0,0,0,0.35);
    }

    .cc-item-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--violet), var(--violet-light), transparent);
        opacity: 0;
        transition: opacity var(--transition);
    }

    .cc-item-card:hover {
        transform: translateY(-3px);
        border-color: var(--border-hover);
        background: var(--bg-card-hover);
        box-shadow:
            0 0 0 1px rgba(139,92,246,0.1),
            0 16px 48px rgba(0,0,0,0.5),
            0 0 30px rgba(139,92,246,0.08);
    }

    .cc-item-card:hover::before { opacity: 1; }

    /* restaurant pill */
    .cc-card-restaurant {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.22rem 0.65rem;
        background: rgba(139,92,246,0.1);
        border: 1px solid rgba(139,92,246,0.2);
        border-radius: 100px;
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--violet-mid);
        letter-spacing: 0.01em;
        margin-bottom: 0.75rem;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* dish name */
    .cc-card-name {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--text-primary);
        line-height: 1.3;
        margin-bottom: 0.85rem;
    }

    .cc-card-name mark {
        background: rgba(192,132,252,0.25);
        color: var(--violet-light);
        border-radius: 3px;
        padding: 0 2px;
    }

    /* footer row */
    .cc-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
    }

    .cc-price-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.3rem 0.75rem;
        background: rgba(192,132,252,0.13);
        border: 1px solid rgba(192,132,252,0.28);
        border-radius: 100px;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1rem;
        font-weight: 700;
        color: var(--violet-light);
    }

    /* per-card language select */
    .cc-card-language-select {
        padding: 0.28rem 0.55rem;
        background: rgba(139,92,246,0.08);
        border: 1px solid rgba(139,92,246,0.22);
        border-radius: 7px;
        color: var(--text-muted);
        font-family: 'Inter', sans-serif;
        font-size: 0.72rem;
        font-weight: 500;
        outline: none;
        cursor: pointer;
        transition: all var(--transition);
        appearance: none;
        -webkit-appearance: none;
    }

    .cc-card-language-select:focus {
        border-color: var(--violet-mid);
        color: var(--text-primary);
    }

    /* ── No-results state ────────────────────────────────────── */
    .cc-no-results {
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 2rem;
        text-align: center;
        gap: 0.75rem;
        grid-column: 1 / -1;
    }

    .cc-no-results.cc-visible { display: flex; }

    .cc-no-results h3 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--text-secondary);
        margin: 0;
    }

    .cc-no-results-clear {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 1.1rem;
        background: rgba(139,92,246,0.1);
        border: 1px solid rgba(139,92,246,0.25);
        border-radius: 9px;
        color: var(--violet-mid);
        font-size: 0.84rem;
        font-weight: 500;
        cursor: pointer;
        transition: all var(--transition);
        font-family: 'Inter', sans-serif;
    }

    .cc-no-results-clear:hover {
        background: rgba(139,92,246,0.18);
        border-color: var(--border-hover);
        color: var(--text-primary);
    }

    /* ── Global empty state ──────────────────────────────────── */
    .cc-empty-page {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 55vh;
        text-align: center;
        gap: 0.85rem;
        animation: cc-fade-up 0.5s ease both;
    }

    .cc-empty-page h2 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--text-secondary);
        margin: 0;
        letter-spacing: -0.01em;
    }

    .cc-empty-page p {
        font-size: 0.9rem;
        color: var(--text-muted);
        max-width: 320px;
        line-height: 1.6;
        margin: 0;
    }

    .cc-cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        margin-top: 0.4rem;
        padding: 0.75rem 1.5rem;
        background: linear-gradient(135deg, var(--violet), #6d28d9);
        color: #fff;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
        font-size: 0.92rem;
        border-radius: 10px;
        text-decoration: none;
        transition: all var(--transition);
        box-shadow: 0 8px 24px rgba(139,92,246,0.35),
        inset 0 1px 0 rgba(255,255,255,0.12);
    }

    .cc-cta-btn:hover {
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 14px 32px rgba(139,92,246,0.5),
        inset 0 1px 0 rgba(255,255,255,0.15);
    }

    /* ── Animations ──────────────────────────────────────────── */
    @@keyframes cc-fade-up {
        from { opacity: 0; transform: translateY(14px); }
        to   { opacity: 1; transform: translateY(0); }
}

    @@keyframes cc-pulse {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.45; }
}

    @@keyframes cc-tl-bounce {
        0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
        40%           { transform: scale(1);   opacity: 1; }
}

    @@keyframes cc-tl-fade {
        from { opacity: 0; transform: translateY(-4px); }
        to   { opacity: 1; transform: translateY(0); }
}

    /* ── Responsive ──────────────────────────────────────────── */
    @@media (max-width: 767px) {
        .cc-catalog-page { padding: 2.5rem 0.85rem 4rem; }
        .cc-grid         { grid-template-columns: 1fr 1fr; gap: 0.75rem; }
        .cc-toolbar      { gap: 0.6rem; }
        .cc-stats-bar    { gap: 0.65rem; }
}

    @@media (max-width: 500px) {
        .cc-grid        { grid-template-columns: 1fr; }
        .cc-search-wrap { min-width: 100%; }
        .cc-sort-select { width: 100%; }
}

    /* ── Per-card translate button ───────────────────────────── */
    .cc-translate-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.26rem 0.65rem;
        background: rgba(139,92,246,0.08);
        border: 1px solid rgba(139,92,246,0.22);
        border-radius: 7px;
        color: var(--text-muted);
        font-family: 'Inter', sans-serif;
        font-size: 0.72rem;
        font-weight: 500;
        cursor: pointer;
        transition: all var(--transition);
        line-height: 1;
        flex-shrink: 0;
    }

    .cc-translate-btn:hover:not(:disabled) {
        background: rgba(139,92,246,0.16);
        border-color: rgba(167,139,250,0.38);
        color: var(--violet-mid);
    }

    .cc-translate-btn:disabled {
        opacity: 0.55;
        cursor: not-allowed;
    }

    .cc-translate-btn .cc-tl-spinner {
        display: none;
        gap: 2px;
        align-items: center;
    }

    .cc-translate-btn .cc-tl-spinner span {
        width: 3px; height: 3px;
        border-radius: 50%;
        background: var(--violet-mid);
        animation: cc-tl-bounce 0.9s ease-in-out infinite;
    }

    .cc-translate-btn .cc-tl-spinner span:nth-child(2) { animation-delay: 0.15s; }
    .cc-translate-btn .cc-tl-spinner span:nth-child(3) { animation-delay: 0.30s; }

    .cc-translate-btn.cc-tl-loading .cc-tl-icon    { display: none; }
    .cc-translate-btn.cc-tl-loading .cc-tl-label   { display: none; }
    .cc-translate-btn.cc-tl-loading .cc-tl-spinner { display: inline-flex; }

    /* Translation result */
    .cc-translation {
        display: none;
        align-items: baseline;
        gap: 0.45rem;
        margin-top: 0.45rem;
        padding: 0.42rem 0.65rem;
        background: rgba(192,132,252,0.07);
        border: 1px solid rgba(192,132,252,0.18);
        border-radius: 8px;
    }

    .cc-translation.cc-visible {
        display: flex;
        animation: cc-tl-fade 0.28s ease both;
    }

    .cc-tl-flag {
        font-size: 0.82rem;
        line-height: 1;
        flex-shrink: 0;
    }

    .cc-tl-text {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.87rem;
        font-weight: 500;
        color: var(--violet-light);
        line-height: 1.3;
        flex: 1;
    }

    /* Error state */
    .cc-tl-error {
        display: none;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.4rem;
        padding: 0.38rem 0.6rem;
        background: rgba(248,113,113,0.08);
        border: 1px solid rgba(248,113,113,0.2);
        border-radius: 8px;
        font-size: 0.75rem;
        color: #fca5a5;
    }

    .cc-tl-error.cc-visible {
        display: flex;
        animation: cc-tl-fade 0.2s ease both;
    }
</style>
}
<div class="cc-catalog-page">
    <div class="cc-catalog-inner">

        <div class="cc-page-header">
            <h1>Every dish, one place.</h1>
            <p>Browse and search all extracted menu items across every restaurant you've scanned.</p>
        </div>

        @if (ViewBag.PendingCount > 0)
        {
        <div class="alert alert-info">
            @ViewBag.PendingCount menu(s) are still processing OCR. Refresh in a few seconds.
        </div>
        }
        @if (!isEmpty)
        {
        int totalItems       = Model.Count;
        int totalRestaurants = Model.Select(x => x.RestaurantName).Distinct().Count();
        var cheapest         = Model.Min(x => x.Price);

        <div class="cc-stats-bar">
            <div class="cc-stat">
                <span class="cc-stat-num">@totalItems</span>
                <span class="cc-stat-label">dishes</span>
            </div>
            <div class="cc-stat">
                <span class="cc-stat-num">@totalRestaurants</span>
                <span class="cc-stat-label">restaurants</span>
            </div>
            <div class="cc-stat">
                <span class="cc-stat-num">€@cheapest.ToString("0.00")</span>
                <span class="cc-stat-label">cheapest item</span>
            </div>
        </div>

        <div class="cc-toolbar">
            <div class="cc-search-wrap">
                <input type="text"
                       id="ccSearch"
                       class="cc-search-input"
                       placeholder="Search dishes or restaurants…"
                       autocomplete="off" />
                <button type="button" class="cc-search-clear" id="ccSearchClear" aria-label="Clear">✕</button>
            </div>

            <select id="ccSort" class="cc-sort-select">
                <option value="default">Default</option>
                <option value="price-asc">Price ↑</option>
                <option value="price-desc">Price ↓</option>
                <option value="name-asc">Name A–Z</option>
            </select>

            <span id="ccResultCount" class="cc-result-count">@totalItems items</span>
        </div>

        <div class="cc-grid" id="ccGrid">
            @for (int i = 0; i < Model.Count; i++)
            {
            var item = Model[i];

            <div class="cc-item-card"
                 data-index="@i"
                 data-name="@((item.Name ?? "").ToLowerInvariant())"
                 data-restaurant="@((item.RestaurantName ?? "").ToLowerInvariant())"
                 data-restaurant-id="@item.RestaurantId"
                 data-price="@item.Price.ToString(CultureInfo.InvariantCulture)">

                <div class="cc-card-restaurant">@item.RestaurantName</div>

                <div class="cc-card-name">@item.Name</div>

                <div class="cc-card-footer">
                    <span class="cc-price-badge">€@item.Price.ToString("0.00")</span>

                    <select class="cc-card-language-select">
                        <option value="en">EN</option>
                        <option value="it">IT</option>
                        <option value="fr">FR</option>
                        <option value="es">ES</option>
                        <option value="de">DE</option>
                        <option value="mt">MT</option>
                    </select>

                    <button type="button"
                            class="cc-translate-btn"
                            data-dish="@item.Name"
                            aria-label="Translate @item.Name">
                        <svg class="cc-tl-icon" width="12" height="12" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2.2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/>
                            <path d="M2 5h12"/><path d="M7 2h1"/>
                            <path d="m22 22-5-10-5 10"/><path d="M14 18h6"/>
                        </svg>
                        <span class="cc-tl-label">Translate</span>
                        <span class="cc-tl-spinner" aria-hidden="true">
                                    <span></span><span></span><span></span>
                                </span>
                    </button>
                </div>

                <div class="cc-translation" role="status" aria-live="polite">
                    <span class="cc-tl-flag">🌐</span>
                    <span class="cc-tl-text"></span>
                </div>
                <div class="cc-tl-error" role="alert">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    Translation failed — try again
                </div>

            </div>
            }

            <div class="cc-no-results" id="ccNoResults">
                <h3>No results found</h3>
                <button type="button" class="cc-no-results-clear" id="ccNoClear">Clear search</button>
            </div>
        </div>
        }
        else
        {
        <div class="cc-empty-page">
            <h2>Your catalog is empty</h2>
            <p>Upload your first restaurant menu to start building your catalog.</p>
            <a href="/menu/upload" class="cc-cta-btn">Upload a Menu</a>
        </div>
        }

    </div>
</div>

@section Scripts {
<script>
    (function () {
        'use strict';

        /* ════════════════════════════════════════
           SEARCH + SORT
        ════════════════════════════════════════ */
        var searchInput = document.getElementById('ccSearch');
        var searchClear = document.getElementById('ccSearchClear');
        var sortSelect  = document.getElementById('ccSort');
        var grid        = document.getElementById('ccGrid');
        var noResults   = document.getElementById('ccNoResults');
        var noClear     = document.getElementById('ccNoClear');
        var resultCount = document.getElementById('ccResultCount');

        if (!grid) return; // empty-page state — nothing to wire up

        var allCards = Array.from(grid.querySelectorAll('.cc-item-card'));

        /* Cache original dish name text so highlight doesn't corrupt it */
        allCards.forEach(function (card) {
            var nameEl = card.querySelector('.cc-card-name');
            card.dataset.originalName = nameEl ? nameEl.textContent.trim() : '';
        });

        function escapeHtml(str) {
            return str.replace(/[&<>"']/g, function (m) {
                return ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#039;' })[m];
            });
        }

        function highlight(text, query) {
            if (!query) return escapeHtml(text);
            var safe = escapeHtml(text);
            var q    = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            return safe.replace(new RegExp('(' + q + ')', 'gi'), '<mark>$1</mark>');
        }

        function applyFilters() {
            var q    = searchInput.value.trim().toLowerCase();
            var sort = sortSelect.value;

            var visible = allCards.filter(function (card) {
                var match = !q ||
                    card.dataset.name.includes(q) ||
                    card.dataset.restaurant.includes(q);
                card.style.display = match ? '' : 'none';
                return match;
            });

            allCards.forEach(function (card) {
                var el = card.querySelector('.cc-card-name');
                if (el) el.innerHTML = highlight(card.dataset.originalName, q);
            });

            visible.sort(function (a, b) {
                if (sort === 'price-asc')  return Number(a.dataset.price) - Number(b.dataset.price);
                if (sort === 'price-desc') return Number(b.dataset.price) - Number(a.dataset.price);
                if (sort === 'name-asc')   return a.dataset.name.localeCompare(b.dataset.name);
                return Number(a.dataset.index) - Number(b.dataset.index);
            });

            visible.forEach(function (card) { grid.insertBefore(card, noResults); });

            noResults.style.display = visible.length ? 'none' : 'block';

            if (resultCount) {
                resultCount.textContent = q
                    ? visible.length + ' of ' + allCards.length + ' items'
                    : allCards.length + ' items';
            }

            searchClear.classList.toggle('cc-visible', q.length > 0);
        }

        searchInput.addEventListener('input', applyFilters);
        sortSelect.addEventListener('change', applyFilters);

        searchClear.addEventListener('click', function () {
            searchInput.value = '';
            applyFilters();
            searchInput.focus();
        });

        if (noClear) {
            noClear.addEventListener('click', function () {
                searchInput.value = '';
                applyFilters();
                searchInput.focus();
            });
        }

        applyFilters();

        /* ════════════════════════════════════════
           TRANSLATION
        ════════════════════════════════════════ */
        var TRANSLATE_URL = '/Catalog/Translate';

        /* POST to endpoint — restaurantId is read from the card's own data attribute */
        function callApi(text, target, card) {
            return fetch(TRANSLATE_URL, {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    text:         text,
                    target:       target,
                    restaurantId: card ? (card.dataset.restaurantId || 'global') : 'global'
                })
            })
                .then(function (res) {
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(function (data) {
                    var result =
                        (typeof data === 'string' ? data : null) ||
                        data.translatedText  ||
                        data.translated_text ||
                        data.translation     ||
                        data.result          || '';
                    if (!result) throw new Error('Empty response');
                    return result;
                });
        }

        /* Put a card into / out of loading state */
        function setCardLoading(btn, resultEl, errorEl, loading) {
            btn.classList.toggle('cc-tl-loading', loading);
            btn.disabled = loading;
            if (loading) {
                resultEl.classList.remove('cc-visible');
                errorEl.classList.remove('cc-visible');
            }
        }

        /* Stamp a successful translation onto a card */
        function showResult(btn, resultEl, resultText, errorEl, text, lang) {
            resultText.textContent = text;
            resultEl.classList.add('cc-visible');
            errorEl.classList.remove('cc-visible');
            btn.dataset.translated = 'true';
            btn.dataset.language   = lang;
            btn.querySelector('.cc-tl-label').textContent = 'Hide';
        }

        /* ════════════════════════════════════════
           PER-CARD translate button
           Delegated to document so it survives OCR poll re-renders
        ════════════════════════════════════════ */
        document.addEventListener('click', function (e) {
            var btn = e.target.closest('.cc-translate-btn');
            if (!btn) return;

            var card       = btn.closest('.cc-item-card');
            var dishName   = btn.dataset.dish || '';
            var resultEl   = card.querySelector('.cc-translation');
            var resultText = card.querySelector('.cc-tl-text');
            var errorEl    = card.querySelector('.cc-tl-error');
            var langSelect = card.querySelector('.cc-card-language-select');
            var lang       = langSelect ? langSelect.value : 'en';

            /* Already translated in this language — toggle visibility only */
            if (btn.dataset.translated === 'true' && btn.dataset.language === lang) {
                var isVisible = resultEl.classList.contains('cc-visible');
                resultEl.classList.toggle('cc-visible', !isVisible);
                btn.querySelector('.cc-tl-label').textContent = isVisible ? 'Translate' : 'Hide';
                return;
            }

            setCardLoading(btn, resultEl, errorEl, true);

            callApi(dishName, lang, card)
                .then(function (text) {
                    showResult(btn, resultEl, resultText, errorEl, text, lang);
                })
                .catch(function () {
                    errorEl.classList.add('cc-visible');
                })
                .finally(function () {
                    setCardLoading(btn, resultEl, errorEl, false);
                });
        });

        /* ════════════════════════════════════════
           PENDING OCR POLL
        ════════════════════════════════════════ */
        var pendingBanner = document.querySelector('.alert.alert-info');

        if (pendingBanner) {
            var catalogPollInterval = setInterval(function () {
                fetch(window.location.href, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                    .then(function (res) { return res.text(); })
                    .then(function (html) {
                        var parser       = new DOMParser();
                        var nextDoc      = parser.parseFromString(html, 'text/html');
                        var stillWaiting = nextDoc.querySelector('.alert.alert-info');
                        var currentInner = document.querySelector('.cc-catalog-inner');
                        var nextInner    = nextDoc.querySelector('.cc-catalog-inner');

                        if (!stillWaiting && currentInner && nextInner) {
                            currentInner.innerHTML = nextInner.innerHTML;
                            clearInterval(catalogPollInterval);
                        }
                    })
                    .catch(function (err) {
                        console.warn('Catalog polling failed:', err);
                    });
            }, 5000);
        }

    }());
</script>
}
